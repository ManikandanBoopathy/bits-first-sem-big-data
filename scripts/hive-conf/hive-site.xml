<?xml version="1.0" encoding="UTF-8"?>
<!--
    hive-site.xml — minimal single-source configuration for Apache Hive 3.1.3
    Target path in VM: $HIVE_HOME/conf/hive-site.xml

    Embedded Derby metastore at /home/hdoop/hive_metastore_db (absolute path).
    Do NOT merge this with hive-default.xml.template — that template carries
    its own javax.jdo.option.ConnectionURL with a relative-path database name
    (metastore_db) which, because Hadoop XML uses last-property-wins, silently
    overrides an absolute path added elsewhere. The result is Derby creating
    a fresh empty metastore in every current working directory a hive command
    is launched from, and subsequent DDL operations failing with
    "Required table missing : VERSION".
-->
<configuration>

  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=/home/hdoop/hive_metastore_db;create=true</value>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.apache.derby.jdbc.EmbeddedDriver</value>
  </property>

  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/user/hive/warehouse</value>
  </property>

  <property>
    <name>hive.exec.scratchdir</name>
    <value>/tmp/hive</value>
  </property>

</configuration>
